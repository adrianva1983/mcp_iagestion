{
  "name": "iagestion-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP (Model Context Protocol) para interactuar con la API v3 de iagestión (CRM inmobiliario)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "iagestion-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/httpServer.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/httpServer.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iagestion",
    "real-estate",
    "crm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
