# Copia este archivo a .env (mismo directorio que docker-compose.yml) y rellena
# los valores reales. .env NO se sube a git (ver .gitignore) ni se copia dentro
# de la imagen Docker (ver .dockerignore) — solo lo usa docker compose para
# inyectar las variables en el contenedor `mcp`.

# Token M2M (Bearer) de la API de iagestión.
IAGESTION_API_TOKEN=

# Secreto propio del servidor MCP HTTP. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Se exige en la URL del endpoint: /mcp/<MCP_ACCESS_TOKEN>
MCP_ACCESS_TOKEN=

# Token de confirmación humana para acciones destructivas (actualizar/eliminar/
# desvincular/publicar-despublicar/gestionar_lead). Tras 5 de estas llamadas en
# 10 minutos, las siguientes exigen "confirmacion_humana" = este valor en los
# argumentos de la tool. Genera uno con el mismo comando que MCP_ACCESS_TOKEN.
# Sin configurar, el servidor arranca igual pero bloquea sin posibilidad de
# confirmación tras superar el umbral (falla cerrado, no abierto).
IAGESTION_CONFIRM_TOKEN=
