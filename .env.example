# Copia este archivo a .env (mismo directorio que docker-compose.yml) y rellena
# los valores reales. .env NO se sube a git (ver .gitignore) ni se copia dentro
# de la imagen Docker (ver .dockerignore) — solo lo usa docker compose para
# inyectar las variables en el contenedor `mcp`.

# --- Modo multiusuario (recomendado) -----------------------------------------
# Clave que cifra en reposo los tokens de iagestión de cada usuario (AES-256-GCM).
# Mínimo 32 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si la pierdes hay que volver a dar de alta los tokens de iagestión (admin set-token).
# No la cambies una vez en uso. Los usuarios se gestionan con:
#   docker compose exec mcp node dist/admin.js add "Nombre"
# (ver docs/multiusuario.md)
USERS_ENCRYPTION_KEY=

# Días de validez del token de acceso de cada usuario (imcp_...) desde que se
# crea o se rota. Pasada esa fecha el servidor lo rechaza hasta que se renueve
# con `admin rotate`. Opcional; por defecto 180.
TOKEN_TTL_DAYS=180

# Dominio público (sin https://) para el despliegue con Caddy (docker-compose.prod.yml).
# Su registro DNS A debe apuntar a la IP del VPS.
MCP_DOMAIN=mcp.tudominio.com

# URL pública completa, solo para que el CLI imprima la URL de cada usuario. En
# docker-compose.prod.yml se calcula sola a partir de MCP_DOMAIN; aquí solo hace
# falta con el compose de desarrollo (túnel).
PUBLIC_BASE_URL=https://mcp.tudominio.com

# Confirmación humana para acciones destructivas (actualizar/eliminar/
# desvincular/publicar-despublicar/gestionar_lead). Tras 5 de estas llamadas en
# 10 minutos (por usuario), las siguientes se bloquean hasta confirmarlas.
# Hay dos mecanismos, y pueden convivir:
#
#  - Por usuario (recomendado): si el usuario tiene un email de confirmación
#    (admin add --email / admin set-email), se le envía un código de 6 dígitos
#    de un solo uso por correo (RESEND_API_KEY más abajo). Una vez confirmado,
#    queda aprobado el resto de la ventana de 10 minutos, sin pedir código en
#    cada llamada.
#  - Heredado, para quien no tenga email configurado (o si falta
#    RESEND_API_KEY): un secreto estático igual para todos.
#
# Sin ninguno de los dos, el servidor arranca igual pero bloquea sin
# posibilidad de confirmación tras superar el umbral (falla cerrado, no
# abierto). Genera el valor con el mismo comando que USERS_ENCRYPTION_KEY;
# debe ser distinto de cualquier token de acceso de usuario.
IAGESTION_CONFIRM_TOKEN=

# --- Código de confirmación por email (opcional, recomendado) ---------------
# Cuenta propia de Resend (https://resend.com), independiente del Mailjet de
# cada agencia en iagestión. Sin RESEND_API_KEY, todos los usuarios caen al
# IAGESTION_CONFIRM_TOKEN estático de arriba, aunque tengan email configurado.
RESEND_API_KEY=

# Remitente de esos emails. Sin dominio propio verificado en Resend puedes
# usar temporalmente "onboarding@resend.dev" (funciona sin configurar nada,
# pero no es apto para producción a largo plazo).
CONFIRM_EMAIL_FROM=iagestion-mcp@tudominio.com

# Minutos de validez de cada código de confirmación. Opcional; por defecto 10.
CONFIRM_TTL_MINUTOS=10

# --- Modo de un solo usuario (heredado, opcional) ----------------------------
# Solo si NO usas usuarios: un único token de acceso para todos los clientes,
# que actúan con este token M2M de iagestión. Pueden convivir con el modo
# multiusuario, pero en producción con varios usuarios déjalos vacíos.
IAGESTION_API_TOKEN=
MCP_ACCESS_TOKEN=
